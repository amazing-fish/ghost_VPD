{
  "id": "TC-QK-230-SPOT-NAME",
  "version": 2,
  "status": "candidate",
  "app": "qiankun_hm",
  "title": "乾崑 VPD 按名称搜索一个已收藏车位",
  "purpose": "OneBox 第 59 行的车位名称子范围（Issue #111 数据驱动自动化身份绑定）。在同轮搜索前从 VPD 首页当前园区行与首页首个收藏车位冒号信息面板独立读回园区、名称、楼层及编号，再输入名称搜索并确定性校验结果同园区组、同行标题、楼层、编号与「路线」入口。路点、按编号搜索与跨形态宽屏布局另行验证。",
  "preconditions": [
    "已登录乾崑，车辆与园区可进入 VPD 首页，无正在执行的 VPD 任务，且当前园区首页收藏区至少存在一条已收藏车位（含楼层与编号字段）。"
  ],
  "env_requirements": {},
  "test_data": {},
  "test_data_none": true,
  "authorizations": [
    "vpd_entry"
  ],
  "steps": [
    {
      "id": "S1",
      "action": "ensure_state",
      "state": "qk_vpd_home",
      "desc": "进入或确认处于当前园区 VPD 首页。"
    },
    {
      "id": "R_PARK",
      "action": "read",
      "target": "qk_home_park_name",
      "read_scope": "self",
      "measure": "fav_park",
      "critical": true,
      "desc": "从 VPD 首页当前园区信息行独立读回当前园区名称。"
    },
    {
      "id": "S_OPEN_PANEL",
      "action": "tap",
      "target": "qk_home_fav_first_spot_panel_btn",
      "expect_text": "添加标签",
      "critical": true,
      "timeout_s": 10,
      "desc": "打开首页收藏区首个车位卡片同 GridItem 内的冒号信息面板。"
    },
    {
      "id": "R_NAME",
      "action": "read",
      "target": "qk_spot_panel_name",
      "read_scope": "self",
      "measure": "fav_spot_name",
      "critical": true,
      "desc": "从独立信息面板读回完整车位名称。"
    },
    {
      "id": "R_FLOOR",
      "action": "read",
      "target": "qk_spot_panel_floor",
      "read_scope": "self",
      "measure": "fav_spot_floor",
      "critical": true,
      "desc": "从独立信息面板读回所属楼层（如 B1）。"
    },
    {
      "id": "R_CODE",
      "action": "read",
      "target": "qk_spot_panel_code",
      "read_scope": "self",
      "pattern": "^[A-Za-z0-9]+-([A-Za-z0-9]+)车位$",
      "measure": "fav_spot_code",
      "critical": true,
      "desc": "从独立信息面板读回并提取车位编号后缀（如 B1-B17车位 -> B17）。"
    },
    {
      "id": "S_CLOSE_PANEL",
      "action": "back",
      "expect_state": "qk_vpd_home",
      "critical": true,
      "timeout_s": 10,
      "desc": "关闭信息面板返回 VPD 首页。"
    },
    {
      "id": "S2",
      "action": "tap",
      "target": "qk_search_entry",
      "expect_state": "qk_spot_search",
      "critical": true,
      "timeout_s": 10,
      "desc": "进入目的地搜索页。"
    },
    {
      "id": "S3",
      "action": "input",
      "target": "qk_search_input",
      "text": "${read:R_NAME}",
      "clear": true,
      "require_empty_after_clear": true,
      "critical": true,
      "retry": 0,
      "timeout_s": 10,
      "desc": "在当前 SearchField 清理并观察到显式空串后，仅输入本轮独立读回的车位名称。"
    },
    {
      "id": "S4",
      "action": "wait",
      "duration_s": 3,
      "desc": "保存第一次搜索结果观测。"
    },
    {
      "id": "S5",
      "action": "wait",
      "duration_s": 1,
      "desc": "保存第二次搜索结果观测。"
    }
  ],
  "assertions": [
    {
      "id": "first-page",
      "type": "state_is",
      "state": "qk_spot_search",
      "desc": "核对首次取样处于搜索页。",
      "at": "S4",
      "advisory": false,
      "oracle_refs": [
        "K-QK-TC-059"
      ]
    },
    {
      "id": "first-query",
      "type": "target_text_equals",
      "target": "qk_search_input",
      "expected": "${read:R_NAME}",
      "desc": "核对首次取样 SearchField 实际输入与本轮读回名称一致。",
      "at": "S4",
      "advisory": false,
      "oracle_refs": [
        "K-QK-TC-059"
      ]
    },
    {
      "id": "first-park",
      "type": "text_present",
      "within": "qk_search_same_park_result_group",
      "text": "${read:R_PARK}",
      "exact": true,
      "desc": "核对首次取样中当前园区结果组同时包含本轮园区名称与当前查询车位 POI。",
      "at": "S4",
      "advisory": false,
      "oracle_refs": [
        "K-QK-TC-059"
      ]
    },
    {
      "id": "first-row-name",
      "type": "text_present",
      "within": "qk_search_name_result_row",
      "text": "${read:R_NAME}",
      "exact": true,
      "desc": "核对首次取样唯一结果行标题精确等于本轮读回名称。",
      "at": "S4",
      "advisory": false,
      "oracle_refs": [
        "K-QK-TC-059"
      ],
      "strict_visible_text": true
    },
    {
      "id": "first-row-floor",
      "type": "text_present",
      "within": "qk_search_name_result_row",
      "text": "${read:R_FLOOR}层",
      "exact": true,
      "desc": "核对首次取样同行楼层精确等于独立面板楼层 + 层。",
      "at": "S4",
      "advisory": false,
      "oracle_refs": [
        "K-QK-TC-059"
      ],
      "strict_visible_text": true
    },
    {
      "id": "first-row-code",
      "type": "text_present",
      "within": "qk_search_name_result_row",
      "text": "${read:R_CODE}",
      "exact": true,
      "desc": "核对首次取样同行车位编号精确等于独立面板提取的编号。",
      "at": "S4",
      "advisory": false,
      "oracle_refs": [
        "K-QK-TC-059"
      ],
      "strict_visible_text": true
    },
    {
      "id": "first-row-route",
      "type": "text_present",
      "within": "qk_search_name_result_row",
      "text": "路线",
      "exact": true,
      "desc": "核对首次取样同行存在「路线」入口。",
      "at": "S4",
      "advisory": false,
      "oracle_refs": [
        "K-QK-TC-059"
      ],
      "strict_visible_text": true
    },
    {
      "id": "second-page",
      "type": "state_is",
      "state": "qk_spot_search",
      "desc": "核对二次取样处于搜索页。",
      "at": "S5",
      "advisory": false,
      "oracle_refs": [
        "K-QK-TC-059"
      ]
    },
    {
      "id": "second-query",
      "type": "target_text_equals",
      "target": "qk_search_input",
      "expected": "${read:R_NAME}",
      "desc": "核对二次取样 SearchField 实际输入与本轮读回名称一致。",
      "at": "S5",
      "advisory": false,
      "oracle_refs": [
        "K-QK-TC-059"
      ]
    },
    {
      "id": "second-park",
      "type": "text_present",
      "within": "qk_search_same_park_result_group",
      "text": "${read:R_PARK}",
      "exact": true,
      "desc": "核对二次取样中当前园区结果组同时包含本轮园区名称与当前查询车位 POI。",
      "at": "S5",
      "advisory": false,
      "oracle_refs": [
        "K-QK-TC-059"
      ]
    },
    {
      "id": "second-row-name",
      "type": "text_present",
      "within": "qk_search_name_result_row",
      "text": "${read:R_NAME}",
      "exact": true,
      "desc": "核对二次取样唯一结果行标题精确等于本轮读回名称。",
      "at": "S5",
      "advisory": false,
      "oracle_refs": [
        "K-QK-TC-059"
      ],
      "strict_visible_text": true
    },
    {
      "id": "second-row-floor",
      "type": "text_present",
      "within": "qk_search_name_result_row",
      "text": "${read:R_FLOOR}层",
      "exact": true,
      "desc": "核对二次取样同行楼层精确等于独立面板楼层 + 层。",
      "at": "S5",
      "advisory": false,
      "oracle_refs": [
        "K-QK-TC-059"
      ],
      "strict_visible_text": true
    },
    {
      "id": "second-row-code",
      "type": "text_present",
      "within": "qk_search_name_result_row",
      "text": "${read:R_CODE}",
      "exact": true,
      "desc": "核对二次取样同行车位编号精确等于独立面板提取的编号。",
      "at": "S5",
      "advisory": false,
      "oracle_refs": [
        "K-QK-TC-059"
      ],
      "strict_visible_text": true
    },
    {
      "id": "second-row-route",
      "type": "text_present",
      "within": "qk_search_name_result_row",
      "text": "路线",
      "exact": true,
      "desc": "核对二次取样同行存在「路线」入口。",
      "at": "S5",

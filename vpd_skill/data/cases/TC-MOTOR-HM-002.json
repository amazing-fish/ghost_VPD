      "id": "A2",
      "at": "S3",
      "type": "node_selected",
      "target": "tab_my",
      "expected": true,
      "desc": "切回后「我的」为选中态",
      "oracle_refs": [
        "K-MOT-001"
      ]
    }
  ],

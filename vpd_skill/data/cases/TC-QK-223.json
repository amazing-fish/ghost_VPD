{
  "id": "TC-QK-223",
  "version": 4,
  "status": "draft",
  "app": "qiankun_hm",
  "title": "乾崑已声明恢复联网场景的VPD首页进入",
  "purpose": "在人工声明联网且无任务前提下检查搜索入口及已知停车数据失败；园区与网络提示只作观察，不用断网规则推导联网恢复、切网转换或刷新已验收。",
  "preconditions": [
    "登录能力按当前页面复用/执行；目标账户终态未确认时不得进入业务；本例的网络/任务/园区仍须独立核实",
    "本次单条诊断的联网/无任务/园区由执行者按当前现场声明；不证明恢复网络转换；当前园区为华为练秋湖研发中心，目标车辆7885由用户本轮授权选择",
    "设备已解锁、亮屏",
    "本候选限原作者声明的 APP 1.0.26.100 / bar；env 为人工前置声明，产品判据适用性仍以实测facts为准",
    "新增任务/车辆/园区范围均须执行前人工核实；声明不是自动采集事实，实测事实与独立判据另核"
  ],
  "env_requirements": {
    "network": "on",
    "app_version": "1.0.26.100",
    "device_form": "bar",
    "vpd_task_state": "none",
    "parking_area": "华为练秋湖研发中心"
  },
  "test_data": {
    "account": {
      "secret": "QIANKUN_PHONE"
    },
    "password": {
      "secret": "QIANKUN_PASSWORD"
    },
    "sms_code": {
      "secret": "QIANKUN_SMS_CODE"
    }
  },
  "authorizations": [
    "vpd_entry",
    "account_state"
  ],
  "steps": [
    {
      "id": "S1",
      "action": "launch",
      "expect_state": "@in_app",
      "timeout_s": 15,
      "desc": "拉起当前实例，不冷启动或登出"
    },
    {
      "id": "S2",
      "action": "ensure_state",
      "state": "qk_target_account_ready",
      "desc": "复用当前登录态；只在实际页面选择密码或短信路径"
    },
    {
      "action": "back",
      "expect_text": "密码管理",
      "retry": 0,
      "id": "S3_ACCOUNT"
    },
    {
      "action": "back",
      "expect_text": "设置",
      "retry": 0,
      "id": "S3_SETTINGS"
    },
    {
      "action": "back",
      "expect_text": "我的车辆",
      "retry": 0,
      "id": "S3_MY"
    },
    {
      "action": "tap",
      "target": "qk_tab_car",
      "retry": 0,
      "expect_state": "qk_car_tab",
      "timeout_s": 10,
      "id": "S3"
    },
    {
      "id": "S4",
      "action": "tap",
      "target": "qk_ads",
      "timeout_s": 15,
      "critical": true,
      "desc": "点 ADS 进 VPD（联网重载）",
      "expect_state": "qk_vpd_home"
    },
    {
      "id": "S5",
      "action": "wait",
      "duration_s": 0,
      "expect_state": "qk_vpd_home",
      "timeout_s": 12,
      "desc": "独立业务观测；不以登录完成代替VPD断言"
    }
  ],
  "assertions": [
    {
      "id": "A1",
      "at": "S5",
      "type": "text_present",
      "text": "搜索车位号设为目的地",
      "exact": false,
      "desc": "搜索车位号设为目的地可见",
      "oracle_refs": [
        "K-QK-013"
      ]
    },
    {
      "id": "A2",
      "at": "S5",
      "type": "text_present",
      "text": "华为练秋湖研发中心",
      "exact": false,
      "desc": "园区/网络提示只读取证；缺独立联网恢复判据，不证明转换或刷新",
      "oracle_refs": [],
      "advisory": true
    },
    {
      "id": "A3",
      "at": "S5",
      "type": "text_absent",
      "text": "网络异常",
      "desc": "园区/网络提示只读取证；缺独立联网恢复判据，不证明转换或刷新",
      "oracle_refs": [],
      "exact": false,
      "advisory": true
    },
    {
      "id": "A4",
      "at": "S5",
      "type": "visual_review",
      "advisory": true,
      "desc": "首页完整性与数据刷新（建议）",
      "prompt": "检查截图：VPD 首页地图/园区名/车位总数/搜索入口/推荐车位是否完整加载，车位总数与断网前对比是否联网刷新。只给建议，不作为缺陷结论"
    },
    {
      "id": "A_NO_LOAD_ERROR",
      "at": "S5",
      "type": "text_absent",
      "text": "停车场信息加载失败",
      "exact": false,
      "desc": "已声明联网场景中排除已知停车数据失败，不证明完整地图就绪",
      "oracle_refs": [
        "K-QK-013"
      ]
    }
  ],
  "cleanup": [

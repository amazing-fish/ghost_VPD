{
  "id": "TC-QK-235",
  "version": 1,
  "status": "candidate",
  "app": "qiankun_hm",
  "title": "乾崑 VPD 按标签「电梯口」筛选（用户裁定扩展维度：标签）",
  "purpose": "2026-10-24 用户裁定「搜索支持名称、车位号、标签、楼层等维度」中的**标签**维度：在 VPD 搜索页（搜索框为空）点标签「电梯口」，核验结果按标签返回该园区带此标签的点位行（形如「B1层-8号楼电梯口附近」）并给出「路线」入口。只覆盖「标签筛选能检索出带该标签的行」，不覆盖标签集合完整性、标签与车位属性对应、排序与算法；判据 K-QK-TC-235 为 unconfirmed，故整例结论只能 pending。",
  "preconditions": [
    "乾崑 APP 已登录（当前复用态）",
    "当前无进行中的 VPD 任务（进入后为地图首页）",
    "VPD 地图已加载且园区存在带「电梯口」标签的点位：2026-10-24 启境1395 实测 由度金闽园 有 5 条（B1层-5/6/8/9号楼电梯口附近、9号楼货梯口附近）",
    "搜索框为空：带查询词（如 B1）时点同一标签结果为空白，因此必须从空搜索页进入",
    "设备已解锁、亮屏、联网"
  ],
  "env_requirements": {},
  "test_data": {
    "tag": "电梯口",
    "park": "由度金闽园",
    "expect_row_fragment": "号楼电梯口附近"
  },
  "authorizations": [
    "vpd_entry"
  ],
  "steps": [
    {
      "id": "S1",
      "action": "stop_app",
      "desc": "冷启动前置：结束目标 APP（不登出、不切车）"
    },
    {
      "id": "S2",
      "action": "launch",
      "expect_state": "@in_app",
      "timeout_s": 15,
      "desc": "拉起乾崑 APP"
    },
    {
      "id": "S3",
      "action": "tap",
      "target": "qk_tab_car",
      "timeout_s": 10,
      "critical": true,
      "expect_state": "qk_car_tab",
      "desc": "进「爱车」页"
    },
    {
      "id": "S4",
      "action": "tap",
      "target": "qk_ads",
      "timeout_s": 20,
      "critical": true,
      "expect_state": "qk_vpd_home",
      "desc": "进入泊车代驾地图"
    },
    {
      "id": "S5",
      "action": "tap",
      "target": "qk_search_entry",
      "timeout_s": 10,
      "critical": true,
      "expect_state": "qk_spot_search",
      "desc": "进入搜索二级页面（此时搜索框为空、下方有标签「电梯口」「充电桩」）"
    },
    {
      "id": "S6",
      "action": "tap",
      "target": "qk_tag_elevator",
      "timeout_s": 10,
      "critical": true,
      "desc": "点标签「电梯口」按标签筛选（不输入任何查询词）"
    },
    {
      "id": "S7",
      "action": "wait",
      "duration_s": 4,
      "desc": "等待标签结果列表渲染"
    }
  ],
  "assertions": [
    {
      "id": "A1",
      "at": "S7",
      "type": "text_present",
      "text": "号楼电梯口附近",
      "exact": false,
      "desc": "结果行是按标签命中的点位名（「B1层-8号楼电梯口附近」等），子串匹配以容纳不同楼栋号（2026-10-24 session-s1700 obs-0013）",
      "oracle_refs": [
        "K-QK-TC-235"
      ]
    },
    {
      "id": "A2",
      "at": "S7",
      "type": "text_present",
      "text": "由度金闽园",
      "exact": true,
      "desc": "结果头部给出所在园区，证明结果来自当前园区而非全局推荐",
      "oracle_refs": [
        "K-QK-TC-235"
      ]
    },
    {
      "id": "A3",
      "at": "S7",
      "type": "text_present_any",
      "any": [
        "B1层-8号楼电梯口附近",
